# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# SQLite databases
backend/data/*.db

# Scratch / temporary analysis artifacts (never a deliverable, never committed)
backend/scratch/

# Experiment output (CSVs/figures/tables from dozens of research phases) -
# tens of thousands of files, regenerable from backend/experiments/ and
# backend/reproduce.py. Not a deliverable to keep in git history.
backend/results/

# OS
.DS_Store
Thumbs.db

# Node (root package.json runs the dev servers via `concurrently`)
node_modules/

# Logs
*.log

# SQLite sidecar files (WAL/shared memory) next to the git-ignored *.db files
backend/data/*.db-wal
backend/data/*.db-shm

# LaTeX build by-products
*.aux
*.synctex.gz

# reproduce.py leaves its validation directory (pipeline_log.txt, regenerated
# artifacts, snapshots) next to itself after every run
backend/_reproduce_validation_*/
